      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_P_Start__P_Receive" bpmnElement="Flow_P_Start__P_Receive">
        <di:waypoint x="591.0" y="773.0"/>
        <di:waypoint x="645.0" y="773.0"/>
        <di:waypoint x="645.0" y="770.5"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_P_Receive__P_Check" bpmnElement="Flow_P_Receive__P_Check">
