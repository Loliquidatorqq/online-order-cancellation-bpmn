<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_OrderCancellation" targetNamespace="https://github.com/Loliquidatorqq/online-order-cancellation-bpmn" exporter="Portfolio BPMN reconstruction" exporterVersion="1.0">
  <bpmn:message id="msgCancellation" name="Запрос на отмену заказа"/>
  <bpmn:message id="msgDecline" name="Отказ в отмене"/>
  <bpmn:message id="msgRefundRequest" name="Запрос на возврат средств"/>
  <bpmn:message id="msgRefundApproved" name="Подтверждение возврата"/>
  <bpmn:message id="msgApproved" name="Подтверждение отмены и возврата"/>
  <bpmn:collaboration id="Collaboration_OnlineOrderCancellation">
    <bpmn:participant id="Participant_Customer" name="Клиент" processRef="Process_Customer"/>
    <bpmn:participant id="Participant_Store" name="Интернет-магазин" processRef="Process_Store"/>
    <bpmn:participant id="Participant_Payment" name="Платёжный сервис" processRef="Process_Payment"/>
    <bpmn:messageFlow id="Msg_Cancel" sourceRef="C_Send" targetRef="S_Start" messageRef="msgCancellation"/>
    <bpmn:messageFlow id="Msg_Decline" sourceRef="S_Decline" targetRef="C_Decline" messageRef="msgDecline"/>
    <bpmn:messageFlow id="Msg_RefundRequest" sourceRef="S_RefundRequest" targetRef="P_Start" messageRef="msgRefundRequest"/>
    <bpmn:messageFlow id="Msg_RefundApproved" sourceRef="P_Confirm" targetRef="S_RefundConfirm" messageRef="msgRefundApproved"/>
    <bpmn:messageFlow id="Msg_Approved" sourceRef="S_Notify" targetRef="C_Approved" messageRef="msgApproved"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_Customer" isExecutable="false" name="Клиент">
    <bpmn:startEvent id="C_Start" name="Нужно отменить заказ">
      <bpmn:outgoing>Flow_C_Start__C_Send</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sendTask id="C_Send" name="Отправить запрос на отмену">
      <bpmn:incoming>Flow_C_Start__C_Send</bpmn:incoming>
      <bpmn:outgoing>Flow_C_Send__C_Wait</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:eventBasedGateway id="C_Wait" name="Ожидать ответ">
      <bpmn:incoming>Flow_C_Send__C_Wait</bpmn:incoming>
      <bpmn:outgoing>Flow_C_Wait__C_Decline</bpmn:outgoing>
      <bpmn:outgoing>Flow_C_Wait__C_Approved</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="C_Decline" name="Получено: отмена невозможна">
      <bpmn:messageEventDefinition id="Med_C_Decline" messageRef="msgDecline"/>
      <bpmn:incoming>Flow_C_Wait__C_Decline</bpmn:incoming>
      <bpmn:outgoing>Flow_C_Decline__C_EndDecline</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="C_EndDecline" name="Отмена отклонена">
      <bpmn:incoming>Flow_C_Decline__C_EndDecline</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="C_Approved" name="Получено: заказ отменён, возврат оформлен">
      <bpmn:messageEventDefinition id="Med_C_Approved" messageRef="msgApproved"/>
      <bpmn:incoming>Flow_C_Wait__C_Approved</bpmn:incoming>
      <bpmn:outgoing>Flow_C_Approved__C_EndApproved</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="C_EndApproved" name="Запрос выполнен">
      <bpmn:incoming>Flow_C_Approved__C_EndApproved</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_C_Start__C_Send" sourceRef="C_Start" targetRef="C_Send"/>
    <bpmn:sequenceFlow id="Flow_C_Send__C_Wait" sourceRef="C_Send" targetRef="C_Wait"/>
    <bpmn:sequenceFlow id="Flow_C_Wait__C_Decline" sourceRef="C_Wait" targetRef="C_Decline"/>
    <bpmn:sequenceFlow id="Flow_C_Wait__C_Approved" sourceRef="C_Wait" targetRef="C_Approved"/>
    <bpmn:sequenceFlow id="Flow_C_Decline__C_EndDecline" sourceRef="C_Decline" targetRef="C_EndDecline"/>
    <bpmn:sequenceFlow id="Flow_C_Approved__C_EndApproved" sourceRef="C_Approved" targetRef="C_EndApproved"/>
  </bpmn:process>
  <bpmn:process id="Process_Store" isExecutable="false" name="Интернет-магазин">
    <bpmn:startEvent id="S_Start" name="Получен запрос на отмену">
      <bpmn:messageEventDefinition id="Med_S_Start" messageRef="msgCancellation"/>
      <bpmn:outgoing>Flow_S_Start__S_Receive</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="S_Receive" name="Получить запрос на отмену">
      <bpmn:incoming>Flow_S_Start__S_Receive</bpmn:incoming>
      <bpmn:outgoing>Flow_S_Receive__S_Check</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="S_Check" name="Проверить статус заказа">
      <bpmn:incoming>Flow_S_Receive__S_Check</bpmn:incoming>
      <bpmn:outgoing>Flow_S_Check__S_Decide</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="S_Decide" name="Заказ можно отменить?">
      <bpmn:incoming>Flow_S_Check__S_Decide</bpmn:incoming>
      <bpmn:outgoing>Flow_S_Decide__S_Decline</bpmn:outgoing>
      <bpmn:outgoing>Flow_S_Decide__S_Cancel</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="S_Decline" name="Сообщить клиенту об отказе">
      <bpmn:incoming>Flow_S_Decide__S_Decline</bpmn:incoming>
      <bpmn:outgoing>Flow_S_Decline__S_EndDecline</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="S_EndDecline" name="Отмена отклонена">
      <bpmn:incoming>Flow_S_Decline__S_EndDecline</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="S_Cancel" name="Отменить заказ в системе">
      <bpmn:incoming>Flow_S_Decide__S_Cancel</bpmn:incoming>
      <bpmn:outgoing>Flow_S_Cancel__S_RefundRequest</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="S_RefundRequest" name="Сформировать запрос на возврат">
      <bpmn:incoming>Flow_S_Cancel__S_RefundRequest</bpmn:incoming>
      <bpmn:outgoing>Flow_S_RefundRequest__S_RefundConfirm</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="S_RefundConfirm" name="Подтверждение возврата">
      <bpmn:messageEventDefinition id="Med_S_RefundConfirm" messageRef="msgRefundApproved"/>
      <bpmn:incoming>Flow_S_RefundRequest__S_RefundConfirm</bpmn:incoming>
      <bpmn:outgoing>Flow_S_RefundConfirm__S_Confirm</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="S_Confirm" name="Подтвердить отмену заказа">
      <bpmn:incoming>Flow_S_RefundConfirm__S_Confirm</bpmn:incoming>
      <bpmn:outgoing>Flow_S_Confirm__S_Notify</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sendTask id="S_Notify" name="Уведомить клиента об отмене и возврате">
      <bpmn:incoming>Flow_S_Confirm__S_Notify</bpmn:incoming>
      <bpmn:outgoing>Flow_S_Notify__S_EndApproved</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="S_EndApproved" name="Заказ отменён">
      <bpmn:incoming>Flow_S_Notify__S_EndApproved</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_S_Start__S_Receive" sourceRef="S_Start" targetRef="S_Receive"/>
    <bpmn:sequenceFlow id="Flow_S_Receive__S_Check" sourceRef="S_Receive" targetRef="S_Check"/>
    <bpmn:sequenceFlow id="Flow_S_Check__S_Decide" sourceRef="S_Check" targetRef="S_Decide"/>
    <bpmn:sequenceFlow id="Flow_S_Decide__S_Decline" sourceRef="S_Decide" targetRef="S_Decline" name="Нет"/>
    <bpmn:sequenceFlow id="Flow_S_Decline__S_EndDecline" sourceRef="S_Decline" targetRef="S_EndDecline"/>
    <bpmn:sequenceFlow id="Flow_S_Decide__S_Cancel" sourceRef="S_Decide" targetRef="S_Cancel" name="Да"/>
    <bpmn:sequenceFlow id="Flow_S_Cancel__S_RefundRequest" sourceRef="S_Cancel" targetRef="S_RefundRequest"/>
    <bpmn:sequenceFlow id="Flow_S_RefundRequest__S_RefundConfirm" sourceRef="S_RefundRequest" targetRef="S_RefundConfirm"/>
    <bpmn:sequenceFlow id="Flow_S_RefundConfirm__S_Confirm" sourceRef="S_RefundConfirm" targetRef="S_Confirm"/>
    <bpmn:sequenceFlow id="Flow_S_Confirm__S_Notify" sourceRef="S_Confirm" targetRef="S_Notify"/>
    <bpmn:sequenceFlow id="Flow_S_Notify__S_EndApproved" sourceRef="S_Notify" targetRef="S_EndApproved"/>
  </bpmn:process>
  <bpmn:process id="Process_Payment" isExecutable="false" name="Платёжный сервис">
    <bpmn:startEvent id="P_Start" name="Получен запрос на возврат">
      <bpmn:messageEventDefinition id="Med_P_Start" messageRef="msgRefundRequest"/>
      <bpmn:outgoing>Flow_P_Start__P_Receive</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="P_Receive" name="Получить запрос на возврат">
      <bpmn:incoming>Flow_P_Start__P_Receive</bpmn:incoming>
      <bpmn:outgoing>Flow_P_Receive__P_Check</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="P_Check" name="Проверить платёж">
      <bpmn:incoming>Flow_P_Receive__P_Check</bpmn:incoming>
      <bpmn:outgoing>Flow_P_Check__P_Refund</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="P_Refund" name="Выполнить возврат денежных средств">
      <bpmn:incoming>Flow_P_Check__P_Refund</bpmn:incoming>
      <bpmn:outgoing>Flow_P_Refund__P_Confirm</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="P_Confirm" name="Отправить подтверждение возврата">
      <bpmn:incoming>Flow_P_Refund__P_Confirm</bpmn:incoming>
      <bpmn:outgoing>Flow_P_Confirm__P_End</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="P_End" name="Возврат выполнен">
      <bpmn:incoming>Flow_P_Confirm__P_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_P_Start__P_Receive" sourceRef="P_Start" targetRef="P_Receive"/>
    <bpmn:sequenceFlow id="Flow_P_Receive__P_Check" sourceRef="P_Receive" targetRef="P_Check"/>
    <bpmn:sequenceFlow id="Flow_P_Check__P_Refund" sourceRef="P_Check" targetRef="P_Refund"/>
    <bpmn:sequenceFlow id="Flow_P_Refund__P_Confirm" sourceRef="P_Refund" targetRef="P_Confirm"/>
    <bpmn:sequenceFlow id="Flow_P_Confirm__P_End" sourceRef="P_Confirm" targetRef="P_End"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Main">
